{
  "name": "my-project",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "dotnet run --project dotnet/MyProject.Api",
    "build": "pnpm run build:web && pnpm run build:api",
    "build:web": "pnpm --filter web build",
    "build:api": "dotnet build dotnet/MyProject.sln",
    "test": "pnpm run test:web && pnpm run test:api",
    "test:web": "pnpm --filter web test",
    "test:api": "dotnet test dotnet/MyProject.sln"
  }
}
